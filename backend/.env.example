# Court Vision AI — Backend Environment Variables
# Copy this file to .env and fill in your values.

# ─── Application ──────────────────────────────────────────────
APP_NAME="Court Vision AI"
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true

# ─── API ──────────────────────────────────────────────────────
API_PREFIX=/api
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Database ─────────────────────────────────────────────────
POSTGRES_USER=courtadmin
POSTGRES_PASSWORD=courtpass
POSTGRES_DB=court_vision
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://courtadmin:courtpass@localhost:5432/court_vision

# ─── Storage ──────────────────────────────────────────────────
# Options: local | s3
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage/documents
MAX_UPLOAD_SIZE_MB=50

# ─── Auth (Phase 1 — Dev Mode) ────────────────────────────────
# In development, a single auto-authenticated user is used.
# Set AUTH_MODE=production and fill JWT secrets for real auth.
AUTH_MODE=development
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_USER_EMAIL=counsel@courtvision.dev
DEV_USER_NAME=Dev Counsel

# JWT secrets (ready for Phase 2 real auth)
JWT_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
